# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time,
# so set them in the build environment of each deployment.

# Both must be absolute http(s) URLs (e.g. https://example.com); anything else fails the build.

# URL of the Mandarić Method product app (separate Next.js site).
# Every app link ("Prijavi se", "Započni", "Pogledaj program") points here. Default: http://localhost:3001 (the app's dev port).
# Required for production: a Vercel production build fails without it, other production builds warn.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public URL of this landing page; base for absolute Open Graph URLs.
# Optional on Vercel (falls back to the production domain); default: http://localhost:3002 (this site's dev port)
# (production builds warn when it falls back to localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3002
